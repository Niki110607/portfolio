# ==========================================
# Root .gitignore for Portfolio Monorepo
# ==========================================

# Operating System & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Environment Variables & Secrets
.env
.env.local
*.env

# ------------------------------------------
# Python Backend Ignores
# ------------------------------------------
backend/venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
*.pyc
*.pyo
*.pyd

# Model Checkpoints (If larger than 100MB)
# backend/models/*.pt

# ------------------------------------------
# React / Node Frontend Ignores
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
*.log

# Testing / Coverage
coverage/
.pytest_cache/